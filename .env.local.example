# Copy this file to .env.local and fill in your EmailJS credentials.
# All three are required for the contact form (src/components/ContactForm.tsx)
# to send mail. They are NEXT_PUBLIC_* because EmailJS sends directly from
# the browser — there is no backend server in this project. The public key
# and IDs are safe to expose client-side; EmailJS scopes what a public key
# can do at the service/template level in your EmailJS dashboard.
#
# Get these values from https://www.emailjs.com after creating an account:
#   1. Add an Email Service (e.g. Gmail) -> copy its Service ID
#   2. Create an Email Template with variables: from_name, from_email,
#      subject, message -> copy its Template ID
#   3. Account > General > copy your Public Key

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
